---
import Header from "../components/Header.astro";
import Navigation from "../components/Navigation.astro";
import "../styles/main.css";
import { readFileSync } from "fs";
import { join } from "path";

interface Props {
  title?: string;
}

// Try to load tag metadata at build time
let tagMetadata: any = null;
try {
  const tagMetadataPath = join(process.cwd(), "public", "data", "tag-metadata.json");
  const tagMetadataContent = readFileSync(tagMetadataPath, "utf-8");
  tagMetadata = JSON.parse(tagMetadataContent);
} catch (error) {
  // Tag metadata doesn't exist yet or can't be read
}

// Use tag-specific title/subtitle if available, otherwise use defaults
const siteTitle = tagMetadata?.title || Astro.props.title || "Geomate";
const siteSubtitle = tagMetadata?.subtitle || "Explore what Vienna has to offer";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteSubtitle} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{siteTitle}</title>
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
    />
  </head>
  <body>
    <div class="container">
      <Header title={siteTitle} subtitle={siteSubtitle} />

      <!-- Mobile Navigation Toggle -->
      <button
        id="mobile-nav-toggle"
        class="mobile-nav-toggle"
        type="button"
        title="Toggle navigation"
        aria-label="Toggle navigation"
      >
        <span class="toggle-icon">▶</span>
      </button>

      <!-- Mobile Navigation Overlay -->
      <div id="mobile-nav-overlay" class="mobile-nav-overlay"></div>

      <Navigation />
      <main>
        <slot />
      </main>

      
    </div>

    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
    ></script>
    <script
      is:inline
      src="https://unpkg.com/leaflet-polylinedecorator@1.6.0/dist/leaflet.polylineDecorator.js"
    ></script>
    <script src="../lib/map-init.js"></script>

    <script is:inline>
      // Mobile navigation toggle
      (function() {
        const mobileNavToggle = document.getElementById('mobile-nav-toggle');
        const mobileNavOverlay = document.getElementById('mobile-nav-overlay');
        const nav = document.querySelector('.graetzl-nav');
        const toggleIcon = mobileNavToggle?.querySelector('.toggle-icon');

        if (mobileNavToggle && mobileNavOverlay && nav) {
          function openMobileNav() {
            nav.classList.add('mobile-nav-open');
            mobileNavOverlay.classList.add('active');
            mobileNavToggle.classList.add('nav-open');
            if (toggleIcon) toggleIcon.textContent = '◀';
            document.body.style.overflow = 'hidden'; // Prevent scrolling when nav is open
          }

          function closeMobileNav() {
            nav.classList.remove('mobile-nav-open');
            mobileNavOverlay.classList.remove('active');
            mobileNavToggle.classList.remove('nav-open');
            if (toggleIcon) toggleIcon.textContent = '▶';
            document.body.style.overflow = '';
          }

          // Toggle navigation on button click
          mobileNavToggle.addEventListener('click', function() {
            if (nav.classList.contains('mobile-nav-open')) {
              closeMobileNav();
            } else {
              openMobileNav();
            }
          });

          // Close navigation when clicking overlay
          mobileNavOverlay.addEventListener('click', closeMobileNav);

          // Close mobile nav when selecting a list or category
          nav.addEventListener('click', function(e) {
            const target = e.target;
            // Close if clicking on a dropdown option or list select option
            if (target.classList.contains('graetzl-option') ||
                target.closest('.graetzl-option') ||
                (target.tagName === 'OPTION' && target.closest('.list-select'))) {
              // Delay closing slightly to allow the selection to register
              setTimeout(closeMobileNav, 100);
            }
          });

          // Hide mobile nav toggle and show nav on desktop
          function handleResize() {
            if (window.innerWidth > 768) {
              closeMobileNav();
              mobileNavToggle.style.display = 'none';
              mobileNavOverlay.style.display = 'none';
            } else {
              mobileNavToggle.style.display = 'flex';
              mobileNavOverlay.style.display = 'block';
            }
          }

          handleResize();
          window.addEventListener('resize', handleResize);
        }
      })();
    </script>
  </body>
</html>
