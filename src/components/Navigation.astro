<nav class="graetzl-nav">
  <div class="nav-section">
    <h2 data-i18n="nav.selectList">Choose List</h2>
    <div class="searchable-select">
      <input
        type="text"
        id="list-search"
        class="graetzl-search-input"
        data-i18n-placeholder="placeholder.noList"
        placeholder="Select a list"
        autocomplete="off"
        data-selected="false"
      />
      <button
        id="clear-list"
        class="clear-button"
        type="button"
        style="display: none;"
        data-i18n-title="button.clearSelection"
        title="Clear selection">×</button
      >
      <div id="list-dropdown" class="graetzl-dropdown" style="display: none;">
        <!-- Options will be populated dynamically -->
      </div>
    </div>
  </div>

  <div class="nav-section" style="display: none;">
    <h2 data-i18n="nav.selectGraetzl">Select Neighborhood</h2>
    <div class="searchable-select">
      <input
        type="text"
        id="graetzl-search"
        class="graetzl-search-input"
        data-i18n-placeholder="placeholder.allGraetzl"
        placeholder="All neighborhoods shown"
        autocomplete="off"
        data-selected="false"
      />
      <button
        id="clear-graetzl"
        class="clear-button"
        type="button"
        style="display: none;"
        data-i18n-title="button.clearSelection"
        title="Clear selection">×</button
      >
      <div
        id="graetzl-dropdown"
        class="graetzl-dropdown"
        style="display: none;"
      >
        <!-- Options will be populated dynamically -->
      </div>
    </div>
  </div>

  <div class="nav-section" style="display: none;">
    <h2 data-i18n="nav.filterCategories">Filter Categories</h2>
    <div class="category-filter-container">
      <button id="category-toggle" class="category-toggle" type="button">
        <span class="category-toggle-text" data-i18n="category.allCategories"
          >All Categories</span
        >
        <span class="category-toggle-icon">▼</span>
      </button>
      <div
        id="category-dropdown"
        class="category-dropdown"
        style="display: none;"
      >
        <div class="category-dropdown-header">
          <button
            id="select-all-categories"
            class="category-action-btn"
            type="button"
            data-i18n="button.selectAll">Select all</button
          >
          <button
            id="deselect-all-categories"
            class="category-action-btn"
            type="button"
            data-i18n="button.deselectAll">Deselect all</button
          >
        </div>
        <div class="category-search-wrapper">
          <input
            type="text"
            id="category-search"
            class="category-search-input"
            data-i18n-placeholder="placeholder.searchCategories"
            placeholder="Search categories..."
            autocomplete="off"
          />
        </div>
        <div id="category-filters" class="category-filters">
          <!-- Will be populated dynamically -->
        </div>
      </div>
    </div>
  </div>
</nav>
