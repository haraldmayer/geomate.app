---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = "Geomate", subtitle = "Explore what Vienna has to offer" } = Astro.props;
---

<header>
  <div class="header-content">
    <div class="header-title">
      <h1>{title}</h1>
      <p id="header-subtitle" class="subtitle">{subtitle}</p>
    </div>
    <button
      id="language-switcher"
      class="language-switcher"
      type="button"
      title="Switch language"
    >
      <span id="language-switcher-text">EN</span>
    </button>
  </div>
</header>
