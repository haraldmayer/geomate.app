# Cache control for static assets with hashes
# These have content hashes in filenames, so can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/chunks/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML and data files should not be cached (or very short cache)
# This ensures users always get the latest page with latest asset references
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Data files should have short cache
/data/*.json
  Cache-Control: public, max-age=300, must-revalidate
